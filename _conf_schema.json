{
  "draw_settings": {
    "description": "抽取与图鉴设置",
    "type": "object",
    "items": {
      "daily_draw_limit": {
        "description": "每人每日抽取次数",
        "type": "int",
        "default": 3,
        "min": 1,
        "max": 100
      },
      "draw_cooldown_seconds": {
        "description": "连续抽取冷却时间（秒）",
        "type": "float",
        "default": 3,
        "min": 0,
        "max": 60
      },
      "guess_timeout_seconds": {
        "description": "猜盟友题目有效时间（秒），超时后自动公布答案",
        "type": "int",
        "default": 180,
        "min": 30,
        "max": 3600
      },
      "gallery_columns": {
        "description": "图鉴每行显示数量",
        "type": "int",
        "default": 10,
        "min": 4,
        "max": 12
      }
    }
  },
  "wikirby_settings": {
    "description": "WiKirby 查询设置",
    "type": "object",
    "items": {
      "wikirby_enabled": {
        "description": "启用卡比百科查询",
        "type": "bool",
        "default": true
      },
      "wikirby_show_image": {
        "description": "百科回复显示页面首图",
        "type": "bool",
        "default": true
      },
      "wikirby_show_details": {
        "description": "显示页面资料、出现地点和趣闻",
        "type": "bool",
        "default": true,
        "hint": "默认读取页面信息框和部分正文栏目；关闭后只显示简介、来源和首图。"
      },
      "wikirby_output_mode": {
        "description": "百科回复形式",
        "type": "string",
        "options": [
          "普通消息",
          "合并转发",
          "仅百科卡片",
          "百科文字+卡片",
          "文字+卡片合并转发"
        ],
        "default": "普通消息",
        "hint": "卡片由 AstrBot 的 T2I 服务渲染为一张完整图片；渲染失败时会自动回退到文字回复。"
      },
      "wikirby_card_template": {
        "description": "百科卡片模板",
        "type": "string",
        "options": [
          "梦之泉",
          "卡比粉彩",
          "瓦豆鲁迪",
          "星际档案"
        ],
        "default": "梦之泉",
        "hint": "选择仅百科卡片及其它卡片模式使用的 HTML 视觉模板。"
      },
      "wikirby_translate_enabled": {
        "description": "使用 LLM 将百科简介和页面资料翻译成简体中文",
        "type": "bool",
        "default": false,
        "hint": "关闭时保留 WiKirby 原文；开启后使用 AstrBot 原生文本模型翻译简介和页面资料，翻译失败会自动显示原文。"
      },
      "wikirby_translate_provider_id": {
        "description": "百科翻译使用的模型提供商",
        "type": "string",
        "_special": "select_provider",
        "default": "",
        "hint": "留空时使用当前聊天会话的 AstrBot 文本模型。"
      },
      "wikirby_api_url": {
        "description": "WiKirby API 地址",
        "type": "string",
        "default": "https://wikirby.com/w/api.php"
      },
      "wikirby_timeout_seconds": {
        "description": "WiKirby 请求超时时间（秒）",
        "type": "float",
        "default": 12,
        "min": 2,
        "max": 60
      },
      "wikirby_cache_ttl_seconds": {
        "description": "WiKirby 查询缓存时间（秒）",
        "type": "int",
        "default": 3600,
        "min": 0,
        "max": 604800
      },
      "wikirby_max_summary_chars": {
        "description": "百科摘要最大长度",
        "type": "int",
        "default": 1800,
        "min": 300,
        "max": 6000
      },
      "wikirby_proxy_url": {
        "description": "可选 Cloudflare Worker 中转地址",
        "type": "string",
        "default": "",
        "hint": "填写 Worker URL，例如 https://kirby-wikirby-proxy.example.workers.dev；留空则直连。不要填写 /w/api.php。"
      },
      "wikirby_proxy_token": {
        "description": "Cloudflare Worker 中转密钥",
        "type": "string",
        "default": "",
        "hint": "对应 Worker 的 WIKIRBY_PROXY_TOKEN，只保存在本机配置中，不要提交到公开仓库。"
      }
    }
  },
  "data_settings": {
    "description": "数据兼容设置",
    "type": "object",
    "items": {
      "image_base_url": {
        "description": "旧素材图床地址",
        "type": "string",
        "default": "http://save.my996.top/?/img/",
        "hint": "本地找不到旧素材时才会尝试使用。完全本地运行可留空。"
      },
      "legacy_data_dir": {
        "description": "旧插件数据目录（可选）",
        "type": "string",
        "default": "",
        "hint": "旧插件使用标准 data/plugins/astrbot_plugin_AnimeWife 目录时无需填写。"
      }
    }
  }
}
